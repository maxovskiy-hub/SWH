#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем FTPАдрес Экспорт;
Перем FTPПорт Экспорт;
Перем FTPЛогин Экспорт;
Перем FTPПароль Экспорт;
Перем FTPКаталог Экспорт;
Перем FTPПассивныйРежим Экспорт;
Перем НомерКИС Экспорт;

#Область ПрограммныйИнтерфейс

// Возвращает сведения о внешней обработке для подсистемы дополнительных отчетов и обработок.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = Неопределено;
	Попытка
		ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	Исключение
		ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке();
	КонецПопытки;
	
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0.0.4";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Выгрузка СВХ на FTP'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Выгрузка данных по отгруженным паллетам СВХ в Excel (.xlsx) на FTP. Запускается по номеру документа КИС (подписка на изменение статуса заказа на отгрузку).'");
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	Попытка
		ПараметрыРегистрации.Назначение.Добавить("Документ.ЗаказНаОтгрузку");
	Исключение
	КонецПопытки;
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Идентификатор = "ВыгрузитьСВХНаFTP";
	Команда.Представление = НСтр("ru = 'Выгрузить СВХ на FTP'");
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКоманныВызовСерверногоМетода();
	Команда.ПоказыватьОповещение = Истина;
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Идентификатор = "НастройкиFTP";
	Команда.Представление = НСтр("ru = 'Настройки FTP (СВХ)'");
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Точка входа для подписки / обработчика событий / дополнительной обработки.
//
// Параметры:
//  ПараметрыЗапуска - Строка, ДокументСсылка.ЗаказНаОтгрузку, Массив, Структура, Неопределено -
//   номер документа КИС, ссылка на заказ, массив заказов/номеров КИС
//   либо структура с ключами: НомерКИС, ЗаказНаОтгрузку, ОбъектыНазначения и параметрами FTP.
//
Процедура ВыполнитьВыгрузку(ПараметрыЗапуска = Неопределено) Экспорт
	
	ВосстановитьНастройки();
	ПрименитьПараметрыЗапуска(ПараметрыЗапуска);
	ПроверитьПараметрыВыгрузки();
	
	ЗаказыНаОтгрузку = ПолучитьЗаказыНаОтгрузку(ПараметрыЗапуска);
	Если ЗаказыНаОтгрузку.Количество() = 0 Тогда
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Информация,
			"Заказы на отгрузку по номеру КИС не найдены. Файлы на FTP не выгружались.");
		Возврат;
	КонецЕсли;
	
	ТаблицаДанных = ПолучитьДанныеВыгрузки(ЗаказыНаОтгрузку);
	Если ТаблицаДанных.Количество() = 0 Тогда
		ЗаписатьВЖурнал(
			УровеньЖурналаРегистрации.Информация,
			"Запрос не вернул данные. Файлы на FTP не выгружались.");
		Возврат;
	КонецЕсли;
	
	НомераЗаказов = ТаблицаДанных.Скопировать();
	НомераЗаказов.Свернуть("НомерЗаказа");
	
	СоединениеFTP = ПолучитьСоединениеFTP();
	КаталогFTP = НормализоватьКаталогFTP(FTPКаталог);
	
	Выгружено = 0;
	Для Каждого СтрокаНомера Из НомераЗаказов Цикл
		
		ИмяФайла = ИмяФайлаПоНомеруЗаказа(СтрокаНомера.НомерЗаказа);
		Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборСтрок = Новый Структура("НомерЗаказа", СтрокаНомера.НомерЗаказа);
		СтрокиЗаказа = ТаблицаДанных.НайтиСтроки(ОтборСтрок);
		Если СтрокиЗаказа.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТабличныйДокумент = СформироватьТабличныйДокумент(СтрокиЗаказа);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
		Попытка
			ЗаписатьФайлExcel(ТабличныйДокумент, ИмяВременногоФайла);
			ВыгрузитьФайлНаFTP(СоединениеFTP, ИмяВременногоФайла, КаталогFTP, ИмяФайла);
			Выгружено = Выгружено + 1;
		Исключение
			УдалитьФайлыБезопасно(ИмяВременногоФайла);
			ВызватьИсключение СтрШаблон("Ошибка выгрузки файла %1: %2", ИмяФайла, ОписаниеОшибки());
		КонецПопытки;
		УдалитьФайлыБезопасно(ИмяВременногоФайла);
		
	КонецЦикла;
	
	ЗаписатьВЖурнал(
		УровеньЖурналаРегистрации.Информация,
		СтрШаблон("Выгружено файлов: %1", Формат(Выгружено, "ЧГ=0")));
	
КонецПроцедуры

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ОбъектыНазначения = Неопределено, ПараметрыВыполнения = Неопределено) Экспорт
	
	Если ИдентификаторКоманды = "ВыгрузитьСВХНаFTP" Тогда
		ПараметрыЗапуска = Новый Структура;
		ПараметрыЗапуска.Вставить("ОбъектыНазначения", ОбъектыНазначения);
		Если ТипЗнч(ПараметрыВыполнения) = Тип("Структура") Тогда
			Если ПараметрыВыполнения.Свойство("ОбъектыНазначения") И ОбъектыНазначения = Неопределено Тогда
				ПараметрыЗапуска.Вставить("ОбъектыНазначения", ПараметрыВыполнения.ОбъектыНазначения);
			КонецЕсли;
			Если ПараметрыВыполнения.Свойство("НомерКИС") Тогда
				ПараметрыЗапуска.Вставить("НомерКИС", ПараметрыВыполнения.НомерКИС);
			КонецЕсли;
			Если ПараметрыВыполнения.Свойство("ЗаказНаОтгрузку") Тогда
				ПараметрыЗапуска.Вставить("ЗаказНаОтгрузку", ПараметрыВыполнения.ЗаказНаОтгрузку);
			КонецЕсли;
		КонецЕсли;
		ВыполнитьВыгрузку(ПараметрыЗапуска);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьОбработку() Экспорт
	ВыполнитьВыгрузку();
КонецПроцедуры

Функция ПолучитьДанныеВыгрузки(ЗаказыНаОтгрузку) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПланФактОтгрузкиДвижения.ОбъектХранения.Номенклатура КАК Номенклатура,
	|	ПланФактОтгрузкиДвижения.ОбъектХранения.Номенклатура.Код КАК Артикул,
	|	ПланФактОтгрузкиДвижения.Партия.ДатаПроизводства КАК ДатаПроизводства,
	|	ПланФактОтгрузкиДвижения.ЗаказНаОтгрузку.НомерКИС КАК НомерЗаказа,
	|	ПланФактОтгрузкиДвижения.МестоХранения.Ссылка КАК Паллета,
	|	ПланФактОтгрузкиДвижения.МестоХранения.Штрихкод КАК ПаллетаШтрихкод,
	|	ПланФактОтгрузкиДвижения.Факт КАК Количество,
	|	1 КАК ВКоробе,
	|	СтрокиПлановОтгрузки.Цена КАК Цена,
	|	ШтрихкодыНоменклатуры.Штрихкод КАК ШтрихКодТовара,
	|	ВЫБОР
	|		КОГДА ПланФактОтгрузкиДвижения.ЗаказНаОтгрузку.ТипОтгрузки.Наименование В (""ОтгрузкаНаСВХ"", ""Отгрузка на СВХ"")
	|			ТОГДА ""IN""
	|		ИНАЧЕ ""OUT""
	|	КОНЕЦ КАК ТипОтгрузки
	|ИЗ
	|	РегистрСведений.ПланФактОтгрузкиДвижения КАК ПланФактОтгрузкиДвижения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|		ПО ПланФактОтгрузкиДвижения.ОбъектХранения.Номенклатура = ШтрихкодыНоменклатуры.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтрокиПлановОтгрузки КАК СтрокиПлановОтгрузки
	|		ПО ПланФактОтгрузкиДвижения.ЗаказНаОтгрузку = СтрокиПлановОтгрузки.ЗаказНаОтгрузку
	|			И ПланФактОтгрузкиДвижения.ОбъектХранения = СтрокиПлановОтгрузки.ОбъектХранения
	|ГДЕ
	|	ПланФактОтгрузкиДвижения.ЗаказНаОтгрузку В(&ЗаказыНаОтгрузку)
	|	И ДЛИНАСТРОКИ(ШтрихкодыНоменклатуры.Штрихкод) = 13
	|	И ПланФактОтгрузкиДвижения.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПланФактОтгрузкиДвижения.Факт,
	|	ПланФактОтгрузкиДвижения.ОбъектХранения.Номенклатура,
	|	СтрокиПлановОтгрузки.Цена,
	|	ПланФактОтгрузкиДвижения.ЗаказНаОтгрузку.НомерКИС,
	|	ПланФактОтгрузкиДвижения.Партия.ДатаПроизводства,
	|	ПланФактОтгрузкиДвижения.ОбъектХранения.Номенклатура.Код,
	|	ПланФактОтгрузкиДвижения.МестоХранения.Штрихкод,
	|	ВЫБОР
	|		КОГДА ПланФактОтгрузкиДвижения.ЗаказНаОтгрузку.ТипОтгрузки.Наименование В (""ОтгрузкаНаСВХ"", ""Отгрузка на СВХ"")
	|			ТОГДА ""IN""
	|		ИНАЧЕ ""OUT""
	|	КОНЕЦ,
	|	ПланФактОтгрузкиДвижения.МестоХранения.Ссылка,
	|	ШтрихкодыНоменклатуры.Штрихкод";
	
	Запрос.УстановитьПараметр("ЗаказыНаОтгрузку", ЗаказыНаОтгрузку);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СформироватьТабличныйДокумент(СтрокиДанных) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Колонки = Новый Массив;
	Колонки.Добавить("Номенклатура");
	Колонки.Добавить("Артикул");
	Колонки.Добавить("ДатаПроизводства");
	Колонки.Добавить("НомерЗаказа");
	Колонки.Добавить("Паллета");
	Колонки.Добавить("ПаллетаШтрихкод");
	Колонки.Добавить("Количество");
	Колонки.Добавить("ВКоробе");
	Колонки.Добавить("Цена");
	Колонки.Добавить("ШтрихКодТовара");
	Колонки.Добавить("ТипОтгрузки");
	//Колонки.Добавить("КоробНаменование");
	//Колонки.Добавить("КоробШтрихКод");
	//Колонки.Добавить("СрокГодности");
	
	НомерКолонки = 1;
	Для Каждого ИмяКолонки Из Колонки Цикл
		Область = ТабличныйДокумент.Область(1, НомерКолонки);
		Область.Текст = ИмяКолонки;
		Область.Шрифт = Новый Шрифт(, , Истина);
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	
	НомерСтроки = 2;
	Для Каждого СтрокаДанных Из СтрокиДанных Цикл
		Значения = Новый Массив;
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.Номенклатура, Ложь));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.Артикул, Ложь, Истина));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.ДатаПроизводства, Истина));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.НомерЗаказа, Ложь));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.Паллета, Ложь));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.ПаллетаШтрихкод, Ложь));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.Количество, Ложь, Истина));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.ВКоробе, Ложь, Истина));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.Цена, Ложь, Истина));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.ШтрихКодТовара, Ложь));
		Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.ТипОтгрузки, Ложь));
		//Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.КоробНаменование, Ложь));
		//Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.КоробШтрихКод, Ложь));
		//Значения.Добавить(ПредставлениеЗначенияВыгрузки(СтрокаДанных.СрокГодности, Истина));
		
		НомерКолонки = 1;
		Для Каждого ЗначениеКолонки Из Значения Цикл
			ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст = ЗначениеКолонки;
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ТабличныйДокумент.ФиксацияСверху = 1;
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура СохранитьНастройки() Экспорт
	
	Настройки = НастройкиВСтруктуру();
	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), "Настройки", Настройки, , ИмяПользователяНастроек());
	Исключение
		ХранилищеОбщихНастроек.Сохранить(КлючОбъектаНастроек(), "Настройки", Настройки);
	КонецПопытки;
	
КонецПроцедуры

Процедура ВосстановитьНастройки() Экспорт
	
	УстановитьЗначенияПоУмолчанию();
	
	Настройки = Неопределено;
	Попытка
		Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), "Настройки", , ИмяПользователяНастроек());
	Исключение
		Настройки = Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Попытка
			Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), "Настройки");
		Исключение
			Настройки = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		ПрименитьСтруктуруНастроек(Настройки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(FTPПорт) Тогда
		FTPПорт = 21;
	КонецЕсли;
	Если ТипЗнч(FTPПассивныйРежим) <> Тип("Булево") Тогда
		FTPПассивныйРежим = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЗначенияПоУмолчанию()
	
	Если FTPАдрес = Неопределено Тогда
		FTPАдрес = "";
	КонецЕсли;
	Если FTPПорт = Неопределено Тогда
		FTPПорт = 21;
	КонецЕсли;
	Если FTPЛогин = Неопределено Тогда
		FTPЛогин = "";
	КонецЕсли;
	Если FTPПароль = Неопределено Тогда
		FTPПароль = "";
	КонецЕсли;
	Если FTPКаталог = Неопределено Тогда
		FTPКаталог = "";
	КонецЕсли;
	Если ТипЗнч(FTPПассивныйРежим) <> Тип("Булево") Тогда
		FTPПассивныйРежим = Истина;
	КонецЕсли;
	Если НомерКИС = Неопределено Тогда
		НомерКИС = "";
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьСоединениеFTP() Экспорт
	
	ПроверитьПараметрыВыгрузки();
	СоединениеFTP = ПолучитьСоединениеFTP();
	КаталогFTP = НормализоватьКаталогFTP(FTPКаталог);
	Если ЗначениеЗаполнено(КаталогFTP) Тогда
		СоединениеFTP.НайтиФайлы(КаталогFTP, "*", Ложь);
	Иначе
		СоединениеFTP.НайтиФайлы("/", "*", Ложь);
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьПараметрыЗапуска(ПараметрыЗапуска)
	
	Если ПараметрыЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыЗапуска) = Тип("Строка") Тогда
		НомерКИС = СокрЛП(ПараметрыЗапуска);
		Возврат;
	КонецЕсли;
	
	Если ЭтоСсылкаЗаказа(ПараметрыЗапуска) Тогда
		НомерКИС = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗапуска, "НомерКИС")));
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыЗапуска) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьСтруктуруНастроек(ПараметрыЗапуска);
	
	ЗначениеПараметра = Неопределено;
	Если ПараметрыЗапуска.Свойство("НомерКИС", ЗначениеПараметра) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		НомерКИС = СокрЛП(Строка(ЗначениеПараметра));
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗаказыНаОтгрузку(ПараметрыЗапуска)
	
	Заказы = Новый Массив;
	ДобавитьЗаказыИзЗначения(Заказы, ПараметрыЗапуска);
	
	Если Заказы.Количество() = 0 И ЗначениеЗаполнено(НомерКИС) Тогда
		ДобавитьЗаказыПоНомеруКИС(Заказы, НомерКИС);
	КонецЕсли;
	
	Возврат Заказы;
	
КонецФункции

Процедура ДобавитьЗаказыИзЗначения(Заказы, Значение)
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоСсылкаЗаказа(Значение) Тогда
		ДобавитьЗаказВМассив(Заказы, Значение);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ДобавитьЗаказыПоНомеруКИС(Заказы, Значение);
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элемент Из Значение Цикл
			ДобавитьЗаказыИзЗначения(Заказы, Элемент);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПараметра = Неопределено;
	Если Значение.Свойство("ЗаказНаОтгрузку", ЗначениеПараметра) Тогда
		ДобавитьЗаказыИзЗначения(Заказы, ЗначениеПараметра);
	КонецЕсли;
	Если Значение.Свойство("ОбъектыНазначения", ЗначениеПараметра) Тогда
		ДобавитьЗаказыИзЗначения(Заказы, ЗначениеПараметра);
	КонецЕсли;
	Если Значение.Свойство("НомерКИС", ЗначениеПараметра) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		ДобавитьЗаказыПоНомеруКИС(Заказы, ЗначениеПараметра);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЗаказыПоНомеруКИС(Заказы, Знач НомерДокументаКИС)
	
	НомерДокументаКИС = СокрЛП(Строка(НомерДокументаКИС));
	Если Не ЗначениеЗаполнено(НомерДокументаКИС) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказНаОтгрузку.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаОтгрузку КАК ЗаказНаОтгрузку
	|ГДЕ
	|	НЕ ЗаказНаОтгрузку.ПометкаУдаления
	|	И ЗаказНаОтгрузку.НомерКИС = &НомерКИС";
	Запрос.УстановитьПараметр("НомерКИС", НомерДокументаКИС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьЗаказВМассив(Заказы, Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьЗаказВМассив(Заказы, Заказ)
	
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;
	Если Заказы.Найти(Заказ) = Неопределено Тогда
		Заказы.Добавить(Заказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоСсылкаЗаказа(Значение)
	
	Попытка
		Возврат ТипЗнч(Значение) = Тип("ДокументСсылка.ЗаказНаОтгрузку");
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Процедура ЗаписатьФайлExcel(ТабличныйДокумент, ИмяФайла)
	
	// Записываем сразу в XLSX без использования COM-объекта
	// Это позволяет работать в серверном контексте и фоновых заданиях
	Попытка
		ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	Исключение
		// Если запись в XLSX не удалась, пробуем записать в старый формат XLS
		ИмяВременногоXLS = ПолучитьИмяВременногоФайла("xls");
		Попытка
			ТабличныйДокумент.Записать(ИмяВременногоXLS, ТипФайлаТабличногоДокумента.XLS);
			// Переименовываем файл из XLS в XLSX (простое изменение расширения)
			// Т.к. COM-объект Excel недоступен в серверном контексте
			ПереместитьФайл(ИмяВременногоXLS, ИмяФайла);
		Исключение
			УдалитьФайлыБезопасно(ИмяВременногоXLS);
			ВызватьИсключение;
		КонецПопытки;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПреобразоватьXLSвXLSX(ИмяФайлаXLS, ИмяФайлаXLSX)
	
	Excel = Новый COMОбъект("Excel.Application");
	Excel.DisplayAlerts = Ложь;
	Книга = Excel.Workbooks.Open(ИмяФайлаXLS);
	Книга.SaveAs(ИмяФайлаXLSX, 51);
	Книга.Close(Ложь);
	Excel.Quit();
	Excel = Неопределено;
	
КонецПроцедуры

Функция ПолучитьСоединениеFTP()
	
	Адрес = СокрЛП(FTPАдрес);
	Если НРег(Лев(Адрес, 6)) = "ftp://" Тогда
		Адрес = Сред(Адрес, 7);
	КонецЕсли;
	
	ПозицияДвоеточия = Найти(Адрес, ":");
	ПозицияСлэша = Найти(Адрес, "/");
	Порт = FTPПорт;
	Если Не ЗначениеЗаполнено(Порт) Тогда
		Порт = 21;
	КонецЕсли;
	
	КаталогИзАдреса = "";
	Если ПозицияДвоеточия > 0 И (ПозицияСлэша = 0 Или ПозицияДвоеточия < ПозицияСлэша) Тогда
		Хост = Лев(Адрес, ПозицияДвоеточия - 1);
		Остаток = Сред(Адрес, ПозицияДвоеточия + 1);
		ПозицияСлэшаОстатка = Найти(Остаток, "/");
		Если ПозицияСлэшаОстатка = 0 Тогда
			Попытка
				Порт = Число(Остаток);
			Исключение
			КонецПопытки;
		Иначе
			Попытка
				Порт = Число(Лев(Остаток, ПозицияСлэшаОстатка - 1));
			Исключение
			КонецПопытки;
			КаталогИзАдреса = Сред(Остаток, ПозицияСлэшаОстатка);
		КонецЕсли;
	ИначеЕсли ПозицияСлэша > 0 Тогда
		Хост = Лев(Адрес, ПозицияСлэша - 1);
		КаталогИзАдреса = Сред(Адрес, ПозицияСлэша);
	Иначе
		Хост = Адрес;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(FTPКаталог) И ЗначениеЗаполнено(КаталогИзАдреса) Тогда
		FTPКаталог = КаталогИзАдреса;
	КонецЕсли;
	
	ПассивныйРежим = (FTPПассивныйРежим = Истина);
	Возврат Новый FTPСоединение(Хост, Порт, СокрЛП(Строка(FTPЛогин)), Строка(FTPПароль), , ПассивныйРежим, 30);
	
КонецФункции

Процедура ВыгрузитьФайлНаFTP(СоединениеFTP, ИмяЛокальногоФайла, КаталогFTP, ИмяФайла)
	
	Если ЗначениеЗаполнено(КаталогFTP) Тогда
		Если Прав(КаталогFTP, 1) = "/" Тогда
			ПутьНаFTP = КаталогFTP + ИмяФайла;
		Иначе
			ПутьНаFTP = КаталогFTP + "/" + ИмяФайла;
		КонецЕсли;
		КаталогПоиска = КаталогFTP;
	Иначе
		ПутьНаFTP = ИмяФайла;
		КаталогПоиска = "/";
	КонецЕсли;
	
	Попытка
		НайденныеФайлы = СоединениеFTP.НайтиФайлы(КаталогПоиска, ИмяФайла, Ложь);
		Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
			СоединениеFTP.Удалить(НайденныйФайл.ПолноеИмя);
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	СоединениеFTP.Записать(ИмяЛокальногоФайла, ПутьНаFTP);
	
КонецПроцедуры

Функция ИмяФайлаПоНомеруЗаказа(НомерЗаказа)
	
	ИмяФайла = СокрЛП(Строка(НомерЗаказа));
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат "";
	КонецЕсли;
	
	Недопустимые = "\/:*?""<>|";
	Для Индекс = 1 По СтрДлина(Недопустимые) Цикл
		ИмяФайла = СтрЗаменить(ИмяФайла, Сред(Недопустимые, Индекс, 1), "_");
	КонецЦикла;
	
	Возврат ИмяФайла + ".xlsx";
	
КонецФункции

Функция НормализоватьКаталогFTP(Знач Каталог)
	
	Каталог = СокрЛП(Каталог);
	Если Каталог = "" Или Каталог = "/" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Каталог;
	
КонецФункции

Процедура ПроверитьПараметрыВыгрузки()
	
	Если Не ЗначениеЗаполнено(FTPАдрес) Тогда
		ВызватьИсключение "Не заполнен параметр ""Адрес FTP"". Откройте обработку, укажите параметры FTP и нажмите ""Сохранить настройки"".";
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеЗначенияВыгрузки(Значение, ЭтоДата, ЭтоЧисло = Ложь)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ЭтоДата Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Если ЭтоЧисло Или ТипЗнч(Значение) = Тип("Число") Тогда
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Результат = Формат(Значение, "ЧГ=0");
		Иначе
			Результат = Строка(Значение);
		КонецЕсли;
		Результат = СтрЗаменить(Результат, Символы.НПП, "");
		Результат = СтрЗаменить(Результат, Символ(160), "");
		Результат = СтрЗаменить(Результат, " ", "");
		Результат = СокрЛП(Результат);
		Возврат Результат;
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

Процедура ПрименитьСтруктуруНастроек(Настройки)
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПараметра = Неопределено;
	Если Настройки.Свойство("FTPАдрес", ЗначениеПараметра) Тогда
		FTPАдрес = ЗначениеПараметра;
	КонецЕсли;
	Если Настройки.Свойство("FTPПорт", ЗначениеПараметра) Тогда
		FTPПорт = ЗначениеПараметра;
	КонецЕсли;
	Если Настройки.Свойство("FTPЛогин", ЗначениеПараметра) Тогда
		FTPЛогин = ЗначениеПараметра;
	КонецЕсли;
	Если Настройки.Свойство("FTPПароль", ЗначениеПараметра) Тогда
		FTPПароль = ЗначениеПараметра;
	КонецЕсли;
	Если Настройки.Свойство("FTPКаталог", ЗначениеПараметра) Тогда
		FTPКаталог = ЗначениеПараметра;
	КонецЕсли;
	Если Настройки.Свойство("FTPПассивныйРежим", ЗначениеПараметра) Тогда
		Если ТипЗнч(ЗначениеПараметра) = Тип("Булево") Тогда
			FTPПассивныйРежим = ЗначениеПараметра;
		Иначе
			FTPПассивныйРежим = Истина;
		КонецЕсли;
	КонецЕсли;
	Если Настройки.Свойство("НомерКИС", ЗначениеПараметра) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		НомерКИС = СокрЛП(Строка(ЗначениеПараметра));
	КонецЕсли;
	
КонецПроцедуры

Функция НастройкиВСтруктуру()
	
	Настройки = Новый Структура;
	Настройки.Вставить("FTPАдрес", FTPАдрес);
	Настройки.Вставить("FTPПорт", FTPПорт);
	Настройки.Вставить("FTPЛогин", FTPЛогин);
	Настройки.Вставить("FTPПароль", FTPПароль);
	Настройки.Вставить("FTPКаталог", FTPКаталог);
	Настройки.Вставить("FTPПассивныйРежим", ?(ТипЗнч(FTPПассивныйРежим) = Тип("Булево"), FTPПассивныйРежим, Истина));
	Возврат Настройки;
	
КонецФункции

Функция КлючОбъектаНастроек()
	Возврат "флВыгрузкаСВХНаFTP";
КонецФункции

Функция ИмяПользователяНастроек()
